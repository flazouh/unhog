# Local signing configuration for scripts/release-app.sh.
#
# Copy this file to scripts/release.local.env and fill in your own values.
# scripts/release.local.env is git-ignored and must never be committed.

# Full "Developer ID Application" identity string, exactly as printed by:
#   security find-identity -v -p codesigning
export UNHOG_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Your Apple Developer team identifier (the value in parentheses above).
export UNHOG_TEAM_ID="TEAMID"

# The notarytool keychain profile you created once with:
#   xcrun notarytool store-credentials "<profile>" --apple-id "<id>" --team-id "TEAMID"
export UNHOG_NOTARY_PROFILE="your-notary-profile"

# Alternative to the keychain profile: App Store Connect API key material. This
# is what the Release workflow uses, because a hosted runner has no keychain
# profile to read. Set all three or none; when set, they win over the profile.
#   export UNHOG_NOTARY_KEY_ID="ABC1234567"
#   export UNHOG_NOTARY_ISSUER_ID="00000000-0000-0000-0000-000000000000"
#   export UNHOG_NOTARY_KEY_PATH="$HOME/private_keys/AuthKey_ABC1234567.p8"
#
# The workflow reads the same values from these repository secrets:
#   APPLE_CERTIFICATE_P12       base64 of your Developer ID .p12 export
#   APPLE_CERTIFICATE_PASSWORD  the password set during that .p12 export
#   APPLE_SIGN_IDENTITY         same string as UNHOG_SIGN_IDENTITY above
#   APPLE_TEAM_ID               same string as UNHOG_TEAM_ID above
#   APPLE_NOTARY_KEY_ID         the API key identifier
#   APPLE_NOTARY_ISSUER_ID      the App Store Connect issuer UUID
#   APPLE_NOTARY_KEY_P8         base64 of the AuthKey_*.p8 file
